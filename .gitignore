# Insumos crudos: se descargan con scripts/descargar_datos.sh y pesan ~180 MB.
# No se versionan; lo que se publica son las teselas.
data-raw/

# GeoJSON intermedios: los genera construir_manzanas.py y de ellos salen las
# teselas. Versionarlos duplicaría 100 MB por cada regeneración.
src/data/manzanas_cdmx.geojson
src/data/colonias_cdmx.geojson
src/data/agebs_cdmx.geojson

# Teselas de colonias: generar_teselas.sh las produce, pero ninguna página las
# lee (el mapa agrega a colonia desde los atributos de las manzanas). Son 4 MB
# que se publicarían sin usarse.
src/data/colonias.pmtiles

node_modules/
dist/
.observablehq/
src/.observablehq/
/.env
.DS_Store

# Script del mapa del INIDE, guardado solo para consulta. Trae incrustado el
# token de Mapbox de ESE sitio: es una credencial ajena y no se republica
# (la protección de push de GitHub además lo rechaza). Este tablero no usa
# Mapbox: el mapa va con MapLibre y PMTiles.
/script0.js
referencias/mapa-inide/script0.js

# Bytecode de Python
__pycache__/
